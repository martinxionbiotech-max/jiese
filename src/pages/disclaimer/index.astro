---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { MAIN_SITE_URL } from "../../../shared/config/config";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Health & Medical Disclaimer",
  url: MAIN_SITE_URL + "/disclaimer/",
  description: "This platform provides educational information about problematic pornography use. It is not medical advice, diagnosis, or treatment.",
  isPartOf: { "@type": "WebSite", "name": "Porn Recovery Knowledge Platform", "url": "https://selfcontrolatlas.com" },
};

---
<BaseLayout
  siteTitle="Porn Recovery Knowledge Platform"
  siteUrl={MAIN_SITE_URL}
  title="Health & Medical Disclaimer"
  description="This platform provides educational information about problematic pornography use. It is not medical advice, diagnosis, or treatment."
  canonical="/disclaimer/"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Disclaimer", url: "/disclaimer/" }]}
>
  <h1>Health &amp; Medical Disclaimer</h1>
  <p>This website provides general educational information about problematic pornography
  use (PPU), compulsive sexual behavior, and related recovery experiences. By using this
  site, you acknowledge the following:</p>
  <ul>
    <li><strong>Not medical advice.</strong> Nothing on this site is medical advice,
    diagnosis, treatment, or a substitute for consultation with a qualified healthcare
    professional.</li>
    <li><strong>Not individualized.</strong> Content is general information. It does not
    take into account your personal circumstances, health history, or situation.</li>
    <li><strong>Experiences are not evidence.</strong> Personal experiences and community
    patterns describe what some people reported. They do not establish that a strategy,
    timeline, or outcome applies to you.</li>
    <li><strong>Evidence is summarized, not complete.</strong> Research summaries reflect
    sources available at the time of writing and may be superseded.</li>
    <li><strong>Seek professional help when needed.</strong> If you experience significant
    distress, depression, anxiety, or thoughts of self-harm, contact a qualified
    professional or local emergency services.</li>
  </ul>
  <h2>If you are in crisis</h2>
  <p>If you are in immediate danger or thinking about harming yourself, contact local
  emergency services right now. See the <a href="/crisis-resources/">crisis resources page</a>
  for helplines by country.</p>

</BaseLayout>
