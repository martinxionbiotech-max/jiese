---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { MAIN_SITE_URL } from "../../../shared/config/config";
---
<BaseLayout
  siteTitle="Porn Recovery Knowledge Platform"
  siteUrl={ MAIN_SITE_URL }
  title="Advertising Disclosure"
  description="No ads, no sponsors, no affiliate links, nothing for sale."
  canonical="/advertising-disclosure/"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Advertising Disclosure", url: "/advertising-disclosure/" }]}
>
<h1>Advertising Disclosure</h1>
<p>This platform carries <strong>no advertising</strong> and has <strong>no sponsors</strong>.</p>
<ul>
  <li>No banner ads, no native ads, no sponsored posts.</li>
  <li>No affiliate links and no paid product placements.</li>
  <li>No content is paid for by any third party.</li>
</ul>
<p>Nothing on this site exists to sell you anything. If this ever changes, this disclosure
will be updated before any advertising appears.</p>
<p>Last updated: 2026-10-04.</p>

</BaseLayout>
