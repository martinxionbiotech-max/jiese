---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { getCollection } from 'astro:content';
import { MAIN_SITE_URL } from "../../../shared/config/config";

const questions = (await getCollection('questions')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title));

const siteTitle = "Porn Recovery Knowledge Platform";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Common Questions",
  url: MAIN_SITE_URL + "/problems/",
  description: "Answers to common questions about problematic pornography use, withdrawal, and recovery.",
};
---
<BaseLayout
  siteTitle={siteTitle}
  siteUrl={MAIN_SITE_URL}
  title="Common Questions — Porn Recovery Knowledge Platform"
  description="Direct answers to common questions about problematic pornography use, withdrawal, urges, sexual function, and recovery — with clear labeling of what is known and what is not."
  canonical="/problems/"
  ogImage={MAIN_SITE_URL + "/images/hero-problems.webp"}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Questions", url: "/problems/" }]}
>
  <h1>Common Questions</h1>
  <p>Direct answers to the questions people ask most about problematic pornography use
  and recovery. Each answer separates community experience from scientific evidence, and
  states clearly what is not known.</p>

  <div class="list">
    {questions.map((q) => (
      <a class="row" href={`/problems/${q.data.question_id}/`}>
        <span class="q">{q.data.title}</span>
        <span class="arrow">→</span>
      </a>
    ))}
  </div>

  <style>
    .list { margin-top: var(--space-4); border-top: 1px solid var(--color-border); }
    .row { display: flex; justify-content: space-between; align-items: center;
      padding: var(--space-3) var(--space-2); border-bottom: 1px solid var(--color-border);
      color: inherit; }
    .row:hover { text-decoration: none; background: var(--color-bg-alt); }
    .q { font-size: 15px; }
    .arrow { color: var(--color-accent); }
  </style>
  <section class="sources-block">
    <h2>Evidence &amp; sources</h2>
    <ul>
      <li>
        <a href="https://icd.who.int/en" rel="noopener noreferrer" target="_blank">WHO — ICD-11</a>
        (compulsive sexual behaviour disorder, 6C72) — the international diagnostic classification this platform
        uses when it refers to clinical criteria.
      </li>
      <li>
        <a href="https://data.selfcontrolatlas.com/research/">Research records</a> — the platform's evidence library:
        each study is summarized with an explicit evidence tier, methodology and limitations.
      </li>
      <li>
        <a href="https://data.selfcontrolatlas.com/evidence/">Evidence tiers &amp; strength labels</a> — how claims on
        this site are graded, and what each grade does and does not mean.
      </li>
      <li>
        <a href="https://data.selfcontrolatlas.com/claims/">Claim assessments</a> — common claims about pornography
        and recovery, each rated (supported / mixed / not established).
      </li>
    </ul>
    <p class="note">Individual studies, including DOIs and PubMed links, are listed per record in the research library.
    Nothing on this page is medical advice.</p>
  </section>

</BaseLayout>
