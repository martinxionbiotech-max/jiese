---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { MAIN_SITE_URL } from "../../../shared/config/config";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Terms of Use",
  url: MAIN_SITE_URL + "/terms/",
  description: "Plain-language terms: educational use, no medical reliance, acceptable use.",
  isPartOf: { "@type": "WebSite", "name": "Porn Recovery Knowledge Platform", "url": "https://selfcontrolatlas.com" },
};

---
<BaseLayout
  siteTitle="Porn Recovery Knowledge Platform"
  siteUrl={ MAIN_SITE_URL }
  title="Terms of Use"
  description="Plain-language terms: educational use, no medical reliance, acceptable use."
  canonical="/terms/"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Terms of Use", url: "/terms/" }]}
>
<h1>Terms of Use</h1>
<p>By using this website, you agree to these terms. They are intentionally short and
written in plain language.</p>
<h2>Educational purpose only</h2>
<p>This site provides general educational information about problematic pornography use,
recovery experiences, and related research. It is <strong>not</strong> medical advice,
diagnosis, or treatment, and no professional relationship is formed by using it.</p>
<h2>No professional reliance</h2>
<p>Do not make health decisions based on this site alone. For medical, psychological, or
crisis concerns, consult qualified professionals or local emergency services.</p>
<h2>Content accuracy</h2>
<p>We aim for accuracy and label uncertainty honestly, but information may be incomplete
or outdated. Community-reported content reflects individual experiences, not established
facts. See the Editorial Policy and Disclaimer.</p>
<h2>Acceptable use</h2>
<ul>
  <li>Use the site for personal, non-commercial, educational purposes.</li>
  <li>Do not attempt to re-identify de-identified community content.</li>
  <li>Do not misuse content to harass, diagnose, or target any person or group.</li>
</ul>
<h2>Intellectual property</h2>
<p>Site text and structure are original works. Research summaries paraphrase published
sources and cite them where possible. Do not republish site content wholesale without
permission.</p>
<h2>Liability</h2>
<p>To the maximum extent permitted by law, the site and its maintainers are not liable
for decisions made based on its content. Use is at your own discretion.</p>
<h2>Changes</h2>
<p>These terms may be updated; the current version is always on this page.</p>
<p>Last updated: 2026-10-04.</p>

</BaseLayout>
