---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { MAIN_SITE_URL, DATA_SITE_URL } from "../../../shared/config/config";
---
<BaseLayout
  siteTitle="Porn Recovery Knowledge Platform"
  siteUrl={MAIN_SITE_URL}
  title="About the Project"
  description="About the Porn Recovery Knowledge Platform: a structured knowledge and experience platform for people seeking to understand and recover from problematic pornography use."
  canonical="/about/"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "About", url: "/about/" }]}
>
  <h1>About the Project</h1>
  <p>This project is a structured knowledge and experience platform for people seeking
  to understand and recover from problematic pornography use and compulsive sexual
  behaviors.</p>
  <p>Its core assets are:</p>
  <ul>
    <li><strong>Real recovery experiences</strong> — de-identified and structured</li>
    <li><strong>Community patterns</strong> — recurring observations across experiences</li>
    <li><strong>Scientific evidence</strong> — sourced independently from community data</li>
    <li><strong>A growing knowledge graph</strong> — connecting experiences, triggers,
    strategies, questions, and research</li>
  </ul>
  <h2>Who makes this</h2>
  <p>This is an <strong>independent research / educational knowledge project</strong>.
  It is maintained as a structured knowledge base rather than a commercial platform:
  no advertising, no sponsors, no paid placements, and nothing for sale.</p>
  <ul>
    <li><strong>No fabricated experts.</strong> Content is not authored or reviewed by
    named medical professionals, and we do not claim that it is. Where clinical matters
    are involved, content directs readers to qualified professionals.</li>
    <li><strong>Methodology responsibility.</strong> Data processing (de-identification,
    structuring, editorial rewriting) and evidence synthesis are performed by the project's
    editors following the <a href="/methodology/">published methodology</a> and
    <a href="/editorial-policy/">editorial policy</a>.</li>
    <li><strong>Corrections.</strong> Factual errors are corrected when identified; the
    current version of any page is authoritative. See the
    <a href="/editorial-policy/">editorial policy</a>.</li>
  </ul>

  <h2>Read how content is produced</h2>
  <p><a href="/methodology/">Methodology</a> ·
  <a href="/editorial-policy/">Editorial policy</a> ·
  <a href={DATA_SITE_URL + "/evidence/"}>Evidence standards</a> ·
  <a href={DATA_SITE_URL + "/references/"}>References</a></p>
</BaseLayout>
