---
import "../styles/design-tokens.css";
import { MAIN_SITE_URL, DATA_SITE_URL } from "../config/config";
interface Props {
  siteTitle: string;
  siteUrl: string;
  title: string;
  description?: string;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: { name: string; url: string }[];
  lastUpdated?: string;
  ogType?: string;
  noindex?: boolean;
  nav?: { label: string; href: string }[];
  /** hreflang alternates: [{lang, href}] — 未来多语言时启用 */
  alternates?: { lang: string; href: string }[];
  /** Open Graph image URL (absolute) */
  ogImage?: string;
}
const defaultNav = [
  { label: "Start", href: "/start/", mainSite: true },
  { label: "Recovery", href: "/recovery/", mainSite: true },
  { label: "Experiences", href: "/experiences/", mainSite: true },
  { label: "Problems", href: "/problems/", mainSite: true },
  { label: "Triggers", href: "/triggers/", mainSite: true },
  { label: "Strategies", href: "/strategies/", mainSite: true },
  { label: "Research", href: "/research/" },
];
const { siteTitle, siteUrl, title, description = "", canonical, jsonLd,
  breadcrumbs = [], lastUpdated, ogType = "website", noindex = false,
  alternates = [],
  nav = defaultNav,
  ogImage } = Astro.props;
const canonicalUrl = canonical
  ? (canonical.startsWith("http") ? canonical : siteUrl + canonical)
  : siteUrl + Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    {breadcrumbs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((b, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: b.name,
          item: b.url.startsWith("http") ? b.url : siteUrl + b.url,
        })),
      })} />
    )}
    {Array.isArray(jsonLd)
      ? jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)
      : jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">{siteTitle}</a>
        <nav aria-label="Primary">
          {nav.map((item) => (
            <a href={item.mainSite && siteUrl !== MAIN_SITE_URL ? MAIN_SITE_URL + item.href : item.href}>{item.label}</a>
          ))}
        </nav>
        {siteUrl !== MAIN_SITE_URL && (
          <nav class="cross-nav" aria-label="Main site">
            <span class="cross-label">Main site:</span>
            {defaultNav.filter((i) => i.mainSite).map((item) => (
              <a href={MAIN_SITE_URL + item.href}>{item.label}</a>
            ))}
          </nav>
        )}
      </div>
    </header>
    {breadcrumbs.length > 0 && (
      <nav class="container breadcrumbs" aria-label="Breadcrumb">
        {breadcrumbs.map((b, i) => (
          <span>{i > 0 && " › "}<a href={b.url}>{b.name}</a></span>
        ))}
      </nav>
    )}
    <main class="container"><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <p>This site provides educational information about problematic
        pornography use and recovery. It is not medical advice, diagnosis, or treatment.
        If you are in crisis or concerned about your mental health, contact a qualified
        professional. See the <a href="/disclaimer/">full disclaimer</a>.</p>
        <nav class="footer-nav" aria-label="Footer">
          <a href={MAIN_SITE_URL + "/about/"}>About</a> ·
          <a href={MAIN_SITE_URL + "/methodology/"}>Methodology</a> ·
          <a href={MAIN_SITE_URL + "/tools/"}>Tools</a> ·
          <a href="/editorial-policy/">Editorial Policy</a> ·
          <a href="/privacy-policy/">Privacy</a> ·
          <a href="/terms/">Terms</a> ·
          <a href="/cookie-policy/">Cookies</a> ·
          <a href="/advertising-disclosure/">Advertising Disclosure</a> ·
          <a href="/crisis-resources/">Crisis Resources</a>
        </nav>
        {lastUpdated && <p class="meta">Last updated: {lastUpdated}</p>}
      </div>
    </footer>
    <style>
      .site-header { background: var(--color-primary); }
      .header-inner { display: flex; align-items: center; gap: var(--space-5);
        padding: 12px 16px; flex-wrap: wrap; }
      .brand { color: #fff; font-weight: 700; font-size: 17px; }
      nav a { color: #cfdbe9; margin-right: var(--space-4); font-size: 14px; }
      .footer-nav a { color: var(--color-text-soft); margin-right: var(--space-3);
        font-size: 13px; text-decoration: underline; }
      .footer-nav a:hover { color: var(--color-accent); }
      .cross-nav { margin-top: var(--space-1); }
      .cross-label { color: #8fa3ba; font-size: 12px; margin-right: var(--space-2); }
      .cross-nav a { color: #cfdbe9; margin-right: var(--space-3); font-size: 13px; }
      .cross-nav a:hover { color: #fff; }
      nav a:hover { color: #fff; }
      .breadcrumbs { font-size: 13px; color: var(--color-text-soft);
        padding: var(--space-3) 0 0; }
      .site-footer { margin-top: var(--space-7); padding: var(--space-5) 0;
        background: var(--color-bg-alt); font-size: 13px; color: var(--color-text-soft); }
    </style>
  </body>
</html>
