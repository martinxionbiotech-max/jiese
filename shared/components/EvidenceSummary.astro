---
// AIO Evidence Summary — 顶部统一证据摘要（任务书 Section 3）
// 渲染：Bottom line / Evidence strength / What is supported / What is not established / Key uncertainty
interface Props {
  bottomLine: string;
  strength: string;      // Strong / Moderate / Limited / Mixed / Uncertain
  supported?: string;    // What is supported
  notEstablished?: string; // What is NOT established
  keyUncertainty?: string;
}
const { bottomLine, strength, supported, notEstablished, keyUncertainty } = Astro.props;
---
<div class="evidence-summary" role="note" aria-label="Evidence summary">
  <h2>Evidence Summary</h2>
  <dl>
    <div><dt>Bottom line</dt><dd>{bottomLine}</dd></div>
    <div><dt>Evidence strength</dt><dd>{strength}</dd></div>
    {supported && <div><dt>What is supported</dt><dd>{supported}</dd></div>}
    {notEstablished && <div><dt>What is not established</dt><dd>{notEstablished}</dd></div>}
    {keyUncertainty && <div><dt>Key uncertainty</dt><dd>{keyUncertainty}</dd></div>}
  </dl>
</div>
<style>
  .evidence-summary {
    border: 1px solid var(--color-border, #e0e6ee);
    border-left: 4px solid var(--color-accent, #3b6ea5);
    border-radius: var(--radius-sm, 6px);
    padding: var(--space-4, 1rem) var(--space-5, 1.25rem);
    margin: var(--space-4, 1rem) 0 var(--space-5, 1.5rem);
    background: var(--color-bg-soft, #f7f9fb);
  }
  .evidence-summary h2 { margin-top: 0; font-size: 1.05rem; }
  .evidence-summary dl { margin: 0; display: grid; gap: var(--space-2, 0.5rem); }
  .evidence-summary dt { font-weight: 700; color: var(--color-primary, #1c3d5a); font-size: 0.85rem; }
  .evidence-summary dd { margin: 0 0 0 var(--space-3, 0.75rem); font-size: 0.95rem; line-height: 1.5; }
</style>
